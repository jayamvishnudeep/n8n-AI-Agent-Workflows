    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.message?.content || $input.first().json.text || $input.first().json.content;\n\nif (typeof raw !== 'string') {\n  raw = JSON.stringify(raw);\n}\n\n// Strip accidental code fences if the model added them anyway\nraw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    jira_key: $('Normalize Jira Fields').first().json.jira_key,\n    jira_url: $('Normalize Jira Fields').first().json.jira_url,\n    summary: $('Normalize Jira Fields').first().json.summary,\n    confidence: 'Low',\n    missing_information: 'AI generation failed to return valid JSON — manual RCA needed',\n    rca_generated_date: new Date().toISOString().slice(0, 10)\n  };\n}\n\nreturn [{ json: parsed }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        192
