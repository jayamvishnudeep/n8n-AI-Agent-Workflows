    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst todayStr = new Date().toISOString().slice(0, 10);\n\nconst recentTopics = rows.slice(-30).map(r => r.topic).filter(Boolean);\n\nconst attemptsToday = rows.filter(r => {\n  const ts = (r.timestamp || '').toString();\n  const status = (r.status || '').toString();\n  return ts.startsWith(todayStr) && (status === 'Rejected by user' || status === 'Auto-Discarded');\n}).length;\n\nreturn [{\n  json: {\n    recent_topics: recentTopics.length ? recentTopics.join('; ') : 'None yet — this is the first post.',\n    attempts_today: attemptsToday\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        432
      ],
      "id": "ecf560da-f510-4709-a9b2-b840265e8f7e",
      "name": "Build Recent Topics Context"
    },
