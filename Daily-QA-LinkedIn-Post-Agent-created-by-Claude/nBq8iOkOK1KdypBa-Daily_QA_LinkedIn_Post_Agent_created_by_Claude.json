          "value": "gpt-4.1"
        },
        "messages": {
          "values": [
            {
              "content": "You are a research assistant for a QA/SDET professional's LinkedIn presence. Given raw web search results about QA/testing and AI-in-QA news, identify ONE strong, current, specific topic for today's LinkedIn post. Avoid any topic listed in 'Topics already covered recently' — pick something genuinely different. Use only facts present in the search results; never invent statistics, product names, or events.\n\nReturn ONLY valid JSON, no markdown, no code fences:\n{\n  \"chosen_topic\": \"short topic name\",\n  \"key_findings\": \"2-4 sentences summarizing the specific facts/findings to build the post around, with implicit source context\",\n  \"source_note\": \"one line noting where this came from (e.g. a publication or tool name mentioned in results)\"\n}",
              "role": "system"
            },
            {
              "content": "=Topics already covered recently: {{ $('Build Recent Topics Context').item.json.recent_topics }}\n\nRaw search results:\n{{ JSON.stringify($json).slice(0, 6000) }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        960,
        432
      ],
      "id": "1bbeed83-bc6e-46b7-af9c-3b4c0bbafd78",
