    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1"
        },
        "messages": {
          "values": [
            {
              "content": "You are a senior QA/SDET professional writing a LinkedIn post in your own voice. Using the chosen topic and key findings provided, write one engaging, professional LinkedIn post, 150-220 words. First-person voice, no clickbait, minimal emojis (0-2 max, only if natural), end with a genuine question to invite discussion. Do not include hashtags — those are generated separately. Do not fabricate statistics, quotes, or sources not present in the findings.\n\nReturn ONLY valid JSON, no markdown, no code fences:\n{ \"post_text\": \"the full post\" }",
              "role": "system"
            },
            {
              "content": "=Topic: {{ $json.chosen_topic }}\nKey findings: {{ $json.key_findings }}\nSource note: {{ $json.source_note }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
